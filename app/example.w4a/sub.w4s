# 初期設定
var.set panel_visible (true)

# パネルの表示・非表示切り替え
WarpUI.OnClick btn_toggle_panel {
    if var[panel_visible] = true {
        WarpUI.visibility panel_content (gone)
        var.edit panel_visible (false)
        WarpUI.text btn_toggle_panel (Show Panel)
    }
    if var[panel_visible] = false {
        WarpUI.visibility panel_content (visible)
        var.edit panel_visible (true)
        WarpUI.text btn_toggle_panel (Hide Panel)
    }
}

# スイッチタップ時にもパネル状態を変更
WarpUI.OnClick switch_toggle {
    if var[panel_visible] = true {
        WarpUI.visibility panel_content (gone)
        var.edit panel_visible (false)
        WarpUI.text btn_toggle_panel (Show Panel)
    }
    if var[panel_visible] = false {
        WarpUI.visibility panel_content (visible)
        var.edit panel_visible (true)
        WarpUI.text btn_toggle_panel (Hide Panel)
    }
}

# メイン画面への戻り処理
WarpUI.OnClick btn_back_main {
    WarpUI.screen (main.w4u)
}