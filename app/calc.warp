screen{
    id: (main),

    Header{
        text: ("計算機"),
    },

    text{
        --calc: (""),
        text: (--calc),
        id: (calcDisplay),
        textColor: (gray),
        fontSize: (24)
    },

    text{
        --result: (0),
        text: (--result),
        id: (resultDisplay),
        textColor: (black),
        fontSize: (48)
    },

    hStack{
        tonalButton{
            text: ("7"),
            oneClick: (--calc = --calc + "7")
        },
        tonalButton{
            text: ("8"),
            oneClick: (--calc = --calc + "8")
        },
        tonalButton{
            text: ("9"),
            oneClick: (--calc = --calc + "9")
        },
        button{
            text: ("÷"),
            oneClick: (--calc = --calc + "/")
        },
    },

    hStack{
        tonalButton{
            text: ("4"),
            oneClick: (--calc = --calc + "4")
        },
        tonalButton{
            text: ("5"),
            oneClick: (--calc = --calc + "5")
        },
        tonalButton{
            text: ("6"),
            oneClick: (--calc = --calc + "6")
        },
        button{
            text: ("×"),
            oneClick: (--calc = --calc + "*")
        },
    },

    hStack{
        tonalButton{
            text: ("1"),
            oneClick: (--calc = --calc + "1")
        },
        tonalButton{
            text: ("2"),
            oneClick: (--calc = --calc + "2")
        },
        tonalButton{
            text: ("3"),
            oneClick: (--calc = --calc + "3")
        },
        button{
            text: ("-"),
            oneClick: (--calc = --calc + "-")
        },
    },

    hStack{
        tonalButton{
            text: ("0"),
            oneClick: (--calc = --calc + "0")
        },
        button{
            text: ("="),
            oneClick: (--result = calc{--calc}),
            color: (blue)
        },
        button{
            text: ("+"),
            oneClick: (--calc = --calc + "+")
        },

        button{
            text: ("C"),
            oneClick: (--calc = "", --result = 0),
            color: (red)
        },
    },
}
