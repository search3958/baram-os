config { title("テーマ設定") script("settings.w3s") }
head { text("テーマ設定") }
button.back { text("戻る") type("tonal") }

card {
    text("カラーテーマ")
    text { text("プリセットから選択") }
    flex {
        button.palette-light { text("ライト") }
        button.palette-dark { text("ダーク") }
        button.palette-blue { text("ブルー") }
        button.palette-green { text("グリーン") }
        button.palette-red { text("レッド") }
    }
    flex {
        button.palette-purple { text("パープル") }
        button.palette-orange { text("オレンジ") }
        button.palette-cyan { text("シアン") }
        button.palette-pink { text("ピンク") }
    }
}

card {
    text("壁紙")
    text { text("画像から選択") }
    flex {
        button.wall-baram { text("Baram") }
        button.wall-hanul { text("Hanul") }
        button.wall-reflect { text("Reflect") }
    }
    text { text("塗りつぶし色") }
    flex {
        button.color-white { text("白") }
        button.color-black { text("黒") }
        button.color-gray { text("グレー") }
        button.color-red { text("赤") }
        button.color-blue { text("青") }
        button.color-green { text("緑") }
    }
    flex {
        button.color-yellow { text("黄") }
        button.color-orange { text("オレンジ") }
        button.color-purple { text("紫") }
        button.color-pink { text("ピンク") }
        button.color-cyan { text("シアン") }
        button.color-navy { text("ネイビー") }
    }
    flex {
        button.color-beige { text("ベージュ") }
        button.color-olive { text("オリーブ") }
        button.color-teal { text("ティール") }
        button.color-coral { text("コーラル") }
        button.color-indigo { text("インディゴ") }
        button.color-salmon { text("サーモン") }
    }
}
