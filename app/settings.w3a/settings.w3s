[fun = refreshPointer]
setText pointer-current = os://display/pointer/size
setText trackpad-current = os://trackpad/speed
setText mouse-current = os://mouse/speed
[onClick = pointer-small]
run = os://display/pointer?size=10
fun = refreshPointer
[onClick = pointer-medium]
run = os://display/pointer?size=15
fun = refreshPointer
[onClick = pointer-large]
run = os://display/pointer?size=20
fun = refreshPointer
[onClick = trackpad-1]
run = os://trackpad?speed=1.0
fun = refreshPointer
[onClick = trackpad-3]
run = os://trackpad?speed=3.0
fun = refreshPointer
[onClick = trackpad-5]
run = os://trackpad?speed=5.0
fun = refreshPointer
[onClick = trackpad-6]
run = os://trackpad?speed=6.0
fun = refreshPointer
[onClick = trackpad-8]
run = os://trackpad?speed=8.0
fun = refreshPointer
[onClick = mouse-05]
run = os://mouse?speed=0.5
fun = refreshPointer
[onClick = mouse-1]
run = os://mouse?speed=1.0
fun = refreshPointer
[onClick = mouse-2]
run = os://mouse?speed=2.0
fun = refreshPointer
[onClick = mouse-4]
run = os://mouse?speed=4.0
fun = refreshPointer

[onClick = hud-toggle]
runSwitch hud-toggle = "os://display/hud?enabled="
[onClick = system-reset]
run = os://system/reset?option=all

