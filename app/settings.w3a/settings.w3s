[onClick = palette-orange]
run = os://ui-theme/color?bg=FDF0E0&panel=FFFFFF&text=1A1A1A&muted=666666&border=E0D0B0&btn_primary=E8710A&btn_primary_hover=D56508&btn_tonal=FDEBC8&btn_tonal_hover=FCD8A8&card_bg=FFF8F0
[onClick = palette-cyan]
run = os://ui-theme/color?bg=E0F8F8&panel=FFFFFF&text=1A1A1A&muted=666666&border=B0E0E0&btn_primary=00ACC1&btn_primary_hover=0097A7&btn_tonal=CCF5F5&btn_tonal_hover=B0EDED&card_bg=F0FFFF
[onClick = palette-pink]
