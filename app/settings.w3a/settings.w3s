[onClick = nav-theme]
screen = theme
[onClick = nav-pointer]
screen = pointer
[onClick = nav-hud]
screen = hud
[onClick = nav-system]
screen = system
[onClick = back]
screen = main

[onClick = palette-light]
run = os://ui-theme/color?bg=F0F0F0&panel=FFFFFF&text=1A1A1A&muted=666666&border=D0D0D0&btn_primary=0A60FF&btn_primary_hover=0850DD&btn_tonal=E6E6E6&btn_tonal_hover=D2D2D2&card_bg=F5F5F5
[onClick = palette-dark]
run = os://ui-theme/color?bg=1A1A1A&panel=2A2A2A&text=E0E0E0&muted=999999&border=3A3A3A&btn_primary=4A9EFF&btn_primary_hover=3A8EEF&btn_tonal=3A3A3A&btn_tonal_hover=4A4A4A&card_bg=252525
[onClick = palette-blue]
run = os://ui-theme/color?bg=E8F0FE&panel=FFFFFF&text=1A1A1A&muted=666666&border=C0D0E0&btn_primary=1A73E8&btn_primary_hover=1565C0&btn_tonal=D2E3FC&btn_tonal_hover=BDD8FC&card_bg=F0F4FF
[onClick = palette-green]
