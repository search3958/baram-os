config { title("OS設定の変更") script("permission.w3s") }

head { text("OS設定の変更を許可しますか？") }
text.app-name { text("アプリ: 不明") }
card {
    text("要求された操作")
    text.request-path { text("不明") }
}
text { text("「常に許可」は、このバージョンのアプリにだけ適用されます。アプリが変更されると再確認します。") }
flex {
    button.permission-deny { text("許可しない") type("danger") }
    button.permission-once { text("一度だけ許可") type("tonal") }
    button.permission-always { text("常に許可") }
}
