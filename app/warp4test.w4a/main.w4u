<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:baram="http://schemas.baram.com/apk/res/baram"
    baram:layout_width="fill_parent"
    baram:layout_height="fill_parent"
    baram:orientation="vertical"
    baram:background="#F6F6F6">

    <!-- =========================================================
         Gmail Header
         ========================================================= -->

    <LinearLayout
        baram:layout_width="fill_parent"
        baram:layout_height="52dip"
        baram:orientation="horizontal"
        baram:gravity="center_vertical"
        baram:paddingLeft="14dip"
        baram:paddingRight="8dip"
        baram:background="#D44638">

        <TextView
            baram:layout_width="0dip"
            baram:layout_height="wrap_content"
            baram:layout_weight="1"
            baram:text="Gmail"
            baram:textColor="#FFFFFF"
            baram:textSize="22sp"
            baram:textStyle="bold" />

        <Button
            baram:layout_width="72dip"
            baram:layout_height="40dip"
            baram:text="検索"
            baram:textSize="12sp" />

    </LinearLayout>


    <!-- =========================================================
         Mailbox / account bar
         ========================================================= -->

    <LinearLayout
        baram:layout_width="fill_parent"
        baram:layout_height="44dip"
        baram:orientation="horizontal"
        baram:gravity="center_vertical"
        baram:paddingLeft="12dip"
        baram:paddingRight="10dip"
        baram:background="#EEEEEE">

        <TextView
            baram:layout_width="0dip"
            baram:layout_height="wrap_content"
            baram:layout_weight="1"
            baram:text="受信トレイ"
            baram:textSize="17sp"
            baram:textStyle="bold"
            baram:textColor="#333333" />

        <TextView
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="example@gmail.com"
            baram:textSize="11sp"
            baram:textColor="#777777" />

    </LinearLayout>


    <!-- =========================================================
         Inbox
         ========================================================= -->

    <ScrollView
        baram:layout_width="fill_parent"
        baram:layout_height="0dip"
        baram:layout_weight="1"
        baram:background="#FFFFFF"
        baram:fillViewport="true">

        <LinearLayout
            baram:layout_width="fill_parent"
            baram:layout_height="wrap_content"
            baram:orientation="vertical">


            <!-- ================= Mail 1 ================= -->

            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="86dip"
                baram:orientation="horizontal"
                baram:gravity="center_vertical"
                baram:paddingLeft="8dip"
                baram:paddingRight="8dip"
                baram:background="#FFFFFF">

                <!-- Star -->
                <TextView
                    baram:layout_width="38dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="★"
                    baram:textSize="22sp"
                    baram:textColor="#E5B400" />

                <!-- Message -->
                <LinearLayout
                    baram:layout_width="0dip"
                    baram:layout_height="fill_parent"
                    baram:layout_weight="1"
                    baram:orientation="vertical"
                    baram:gravity="center_vertical"
                    baram:paddingLeft="4dip">

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="Google"
                        baram:textSize="16sp"
                        baram:textStyle="bold"
                        baram:textColor="#111111" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="Google アカウントへようこそ"
                        baram:textSize="14sp"
                        baram:textStyle="bold"
                        baram:textColor="#333333" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="新しいGoogleアカウントをご利用いただきありがとうございます。"
                        baram:textSize="12sp"
                        baram:textColor="#777777"
                        baram:singleLine="true" />

                </LinearLayout>

                <TextView
                    baram:layout_width="58dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="top|right"
                    baram:paddingTop="12dip"
                    baram:text="10:42"
                    baram:textSize="11sp"
                    baram:textStyle="bold"
                    baram:textColor="#555555" />

            </LinearLayout>

            <View
                baram:layout_width="fill_parent"
                baram:layout_height="1dip"
                baram:background="#DDDDDD" />


            <!-- ================= Mail 2 ================= -->

            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="86dip"
                baram:orientation="horizontal"
                baram:gravity="center_vertical"
                baram:paddingLeft="8dip"
                baram:paddingRight="8dip"
                baram:background="#FFFFFF">

                <TextView
                    baram:layout_width="38dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="☆"
                    baram:textSize="22sp"
                    baram:textColor="#888888" />

                <LinearLayout
                    baram:layout_width="0dip"
                    baram:layout_height="fill_parent"
                    baram:layout_weight="1"
                    baram:orientation="vertical"
                    baram:gravity="center_vertical"
                    baram:paddingLeft="4dip">

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="baram Developers"
                        baram:textSize="16sp"
                        baram:textStyle="bold"
                        baram:textColor="#111111" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="baram 開発ニュース"
                        baram:textSize="14sp"
                        baram:textStyle="bold"
                        baram:textColor="#333333" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="baram SDK の最新情報をお届けします。"
                        baram:textSize="12sp"
                        baram:textColor="#777777"
                        baram:singleLine="true" />

                </LinearLayout>

                <TextView
                    baram:layout_width="58dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="top|right"
                    baram:paddingTop="12dip"
                    baram:text="9:15"
                    baram:textSize="11sp"
                    baram:textStyle="bold"
                    baram:textColor="#555555" />

            </LinearLayout>

            <View
                baram:layout_width="fill_parent"
                baram:layout_height="1dip"
                baram:background="#DDDDDD" />


            <!-- ================= Mail 3 ================= -->

            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="86dip"
                baram:orientation="horizontal"
                baram:gravity="center_vertical"
                baram:paddingLeft="8dip"
                baram:paddingRight="8dip"
                baram:background="#F4F4F4">

                <TextView
                    baram:layout_width="38dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="☆"
                    baram:textSize="22sp"
                    baram:textColor="#888888" />

                <LinearLayout
                    baram:layout_width="0dip"
                    baram:layout_height="fill_parent"
                    baram:layout_weight="1"
                    baram:orientation="vertical"
                    baram:gravity="center_vertical"
                    baram:paddingLeft="4dip">

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="山田 太郎"
                        baram:textSize="16sp"
                        baram:textColor="#333333" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="明日の予定について"
                        baram:textSize="14sp"
                        baram:textColor="#444444" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="明日の打ち合わせですが、午後2時からでお願いします。"
                        baram:textSize="12sp"
                        baram:textColor="#888888"
                        baram:singleLine="true" />

                </LinearLayout>

                <TextView
                    baram:layout_width="58dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="top|right"
                    baram:paddingTop="12dip"
                    baram:text="8月12日"
                    baram:textSize="11sp"
                    baram:textColor="#777777" />

            </LinearLayout>

            <View
                baram:layout_width="fill_parent"
                baram:layout_height="1dip"
                baram:background="#DDDDDD" />


            <!-- ================= Mail 4 ================= -->

            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="86dip"
                baram:orientation="horizontal"
                baram:gravity="center_vertical"
                baram:paddingLeft="8dip"
                baram:paddingRight="8dip"
                baram:background="#F4F4F4">

                <TextView
                    baram:layout_width="38dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="★"
                    baram:textSize="22sp"
                    baram:textColor="#E5B400" />

                <LinearLayout
                    baram:layout_width="0dip"
                    baram:layout_height="fill_parent"
                    baram:layout_weight="1"
                    baram:orientation="vertical"
                    baram:gravity="center_vertical"
                    baram:paddingLeft="4dip">

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="佐藤"
                        baram:textSize="16sp"
                        baram:textColor="#333333" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="写真を送ります"
                        baram:textSize="14sp"
                        baram:textColor="#444444" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="先日の旅行で撮影した写真を添付しました。"
                        baram:textSize="12sp"
                        baram:textColor="#888888"
                        baram:singleLine="true" />

                </LinearLayout>

                <TextView
                    baram:layout_width="58dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="top|right"
                    baram:paddingTop="12dip"
                    baram:text="8月10日"
                    baram:textSize="11sp"
                    baram:textColor="#777777" />

            </LinearLayout>

            <View
                baram:layout_width="fill_parent"
                baram:layout_height="1dip"
                baram:background="#DDDDDD" />


            <!-- ================= Mail 5 ================= -->

            <LinearLayout
                baram:layout_width="fill_parent"
                baram:layout_height="86dip"
                baram:orientation="horizontal"
                baram:gravity="center_vertical"
                baram:paddingLeft="8dip"
                baram:paddingRight="8dip"
                baram:background="#F4F4F4">

                <TextView
                    baram:layout_width="38dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="center"
                    baram:text="☆"
                    baram:textSize="22sp"
                    baram:textColor="#888888" />

                <LinearLayout
                    baram:layout_width="0dip"
                    baram:layout_height="fill_parent"
                    baram:layout_weight="1"
                    baram:orientation="vertical"
                    baram:gravity="center_vertical"
                    baram:paddingLeft="4dip">

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="YouTube"
                        baram:textSize="16sp"
                        baram:textColor="#333333" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="おすすめの動画"
                        baram:textSize="14sp"
                        baram:textColor="#444444" />

                    <TextView
                        baram:layout_width="fill_parent"
                        baram:layout_height="wrap_content"
                        baram:text="あなたへのおすすめ動画をチェックしましょう。"
                        baram:textSize="12sp"
                        baram:textColor="#888888"
                        baram:singleLine="true" />

                </LinearLayout>

                <TextView
                    baram:layout_width="58dip"
                    baram:layout_height="fill_parent"
                    baram:gravity="top|right"
                    baram:paddingTop="12dip"
                    baram:text="8月9日"
                    baram:textSize="11sp"
                    baram:textColor="#777777" />

            </LinearLayout>

            <View
                baram:layout_width="fill_parent"
                baram:layout_height="1dip"
                baram:background="#DDDDDD" />

        </LinearLayout>

    </ScrollView>


    <!-- =========================================================
         Bottom commands
         ========================================================= -->

    <LinearLayout
        baram:layout_width="fill_parent"
        baram:layout_height="48dip"
        baram:orientation="horizontal"
        baram:background="#EEEEEE">

        <Button
            baram:layout_width="0dip"
            baram:layout_height="fill_parent"
            baram:layout_weight="1"
            baram:text="メール作成"
            baram:textSize="12sp" />

        <Button
            baram:layout_width="0dip"
            baram:layout_height="fill_parent"
            baram:layout_weight="1"
            baram:text="更新"
            baram:textSize="12sp" />

        <Button
            baram:layout_width="0dip"
            baram:layout_height="fill_parent"
            baram:layout_weight="1"
            baram:text="その他"
            baram:textSize="12sp" />

    </LinearLayout>

</LinearLayout>