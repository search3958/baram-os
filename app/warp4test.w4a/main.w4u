<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:baram="http://schemas.baram.com/apk/res/baram"
    baram:id="@+id/main"
    baram:layout_width="match_parent"
    baram:layout_height="match_parent"
    baram:orientation="vertical">

    <LinearLayout
        baram:layout_width="match_parent"
        baram:layout_height="wrap_content"
        baram:orientation="vertical"
        baram:padding="12dp">

        <TextView
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="baram Components Preview"
            baram:textSize="22sp"
            baram:textStyle="bold"/>

        <Spinner
            baram:id="@+id/themeSpinner"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:layout_marginTop="8dp"/>

    </LinearLayout>

    <View
        baram:layout_width="match_parent"
        baram:layout_height="1dp"
        baram:background="#808080"/>

    
    
    

    <ScrollView
        baram:layout_width="match_parent"
        baram:layout_height="0dp"
        baram:layout_weight="1"
        baram:fillViewport="true">

        <LinearLayout
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:orientation="vertical"
            baram:padding="12dp">

            
            
            

            <TextView
                style="@style/SectionTitle"
                baram:text="Layouts"/>

            <TextView
                style="@style/SectionDescription"
                baram:text="baram Framework の代表的なレイアウト"/>

            

            <TextView
                style="@style/ComponentLabel"
                baram:text="LinearLayout • API 1"/>

            <LinearLayout
                style="@style/ComponentBox"
                baram:orientation="horizontal">

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="A"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="B"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="C"/>

            </LinearLayout>

            

            <TextView
                style="@style/ComponentLabel"
                baram:text="RelativeLayout • API 1"/>

            <RelativeLayout
                style="@style/ComponentBox"
                baram:layout_height="70dp">

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:layout_alignParentLeft="true"
                    baram:text="Left"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:layout_alignParentRight="true"
                    baram:text="Right"/>

            </RelativeLayout>


            <TextView
                style="@style/ComponentLabel"
                baram:text="TableLayout / TableRow • API 1"/>

            <TableLayout
                style="@style/ComponentBox"
                baram:stretchColumns="*">

                <TableRow>

                    <Button
                        baram:layout_width="0dp"
                        baram:layout_height="wrap_content"
                        baram:text="1,1"/>

                    <Button
                        baram:layout_width="0dp"
                        baram:layout_height="wrap_content"
                        baram:text="1,2"/>

                    <Button
                        baram:layout_width="0dp"
                        baram:layout_height="wrap_content"
                        baram:text="1,3"/>

                </TableRow>

                <TableRow>

                    <Button
                        baram:layout_width="0dp"
                        baram:layout_height="wrap_content"
                        baram:text="2,1"/>

                    <Button
                        baram:layout_width="0dp"
                        baram:layout_height="wrap_content"
                        baram:text="2,2"/>

                    <Button
                        baram:layout_width="0dp"
                        baram:layout_height="wrap_content"
                        baram:text="2,3"/>

                </TableRow>

            </TableLayout>

            

            <TextView
                style="@style/ComponentLabel"
                baram:text="GridLayout • API 14"/>

            <GridLayout
                style="@style/ComponentBox"
                baram:columnCount="3">

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="1"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="2"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="3"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="4"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="5"/>

                <Button
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="6"/>

            </GridLayout>

            

            <TextView
                style="@style/ComponentLabel"
                baram:text="AbsoluteLayout • API 1 / deprecated API 3"/>

            <AbsoluteLayout
                style="@style/ComponentBox"
                baram:layout_height="100dp">

                <Button
                    baram:layout_width="150dp"
                    baram:layout_height="wrap_content"
                    baram:layout_x="70dp"
                    baram:layout_y="15dp"
                    baram:text="x=70 y=15"/>

            </AbsoluteLayout>


            
            
            

            <TextView
                style="@style/SectionTitle"
                baram:text="Text &amp; Input"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="TextView • API 1"/>

            <TextView
                style="@style/ComponentBox"
                baram:text="Hello baram"
                baram:textSize="18sp"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="EditText • API 1"/>

            <EditText
                style="@style/ComponentBox"
                baram:hint="Type something..."
                baram:singleLine="true"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="AutoCompleteTextView • API 1"/>

            <AutoCompleteTextView
                baram:id="@+id/autoComplete"
                style="@style/ComponentBox"
                baram:hint="Type A..."
                baram:singleLine="true"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="MultiAutoCompleteTextView • API 1"/>

            <MultiAutoCompleteTextView
                baram:id="@+id/multiAutoComplete"
                style="@style/ComponentBox"
                baram:hint="baram, Apple..."/>


            
            
            

            <TextView
                style="@style/SectionTitle"
                baram:text="Buttons"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="Button • API 1"/>

            <Button
                style="@style/ComponentBox"
                baram:text="Button"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="ImageButton • API 1"/>

            <ImageButton
                style="@style/ComponentBox"
                baram:src="@baram:drawable/ic_menu_camera"
                baram:contentDescription="Camera"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="CheckBox • API 1"/>

            <CheckBox
                style="@style/ComponentBox"
                baram:checked="true"
                baram:text="CheckBox"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="RadioButton / RadioGroup • API 1"/>

            <RadioGroup
                style="@style/ComponentBox"
                baram:orientation="vertical">

                <RadioButton
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:checked="true"
                    baram:text="Option A"/>

                <RadioButton
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="Option B"/>

                <RadioButton
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:text="Option C"/>

            </RadioGroup>

            <TextView
                style="@style/ComponentLabel"
                baram:text="ToggleButton • API 1"/>

            <ToggleButton
                style="@style/ComponentBox"
                baram:checked="true"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="Switch • API 14"/>

            <Switch
                style="@style/ComponentBox"
                baram:checked="true"
                baram:text="Switch"/>


            
            
            

            <TextView
                style="@style/SectionTitle"
                baram:text="Selection"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="Spinner • API 1"/>

            <Spinner
                baram:id="@+id/sampleSpinner"
                style="@style/ComponentBox"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="SeekBar • API 1"/>

            <SeekBar
                style="@style/ComponentBox"
                baram:max="100"
                baram:progress="55"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="RatingBar • API 1"/>

            <RatingBar
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:numStars="5"
                baram:rating="3.5"
                baram:stepSize="0.5"/>


            
            
            

            <TextView
                style="@style/SectionTitle"
                baram:text="Progress"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="ProgressBar • API 1"/>

            <ProgressBar
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="ProgressBar Horizontal • API 1"/>

            <ProgressBar
                style="?baram:attr/progressBarStyleHorizontal"
                baram:layout_width="match_parent"
                baram:layout_height="wrap_content"
                baram:max="100"
                baram:progress="65"/>


            

            <TextView
                style="@style/SectionTitle"
                baram:text="Date &amp; Time"/>
            <TextView
                style="@style/ComponentLabel"
                baram:text="Chronometer • API 1"/>

            <Chronometer
                baram:id="@+id/chronometer"
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:textSize="22sp"/>

            
            

            <TextView
                style="@style/SectionTitle"
                baram:text="Other Widgets"/>

            <TextView
                style="@style/ComponentLabel"
                baram:text="HorizontalScrollView • API 1"/>

            <HorizontalScrollView
                baram:layout_width="match_parent"
                baram:layout_height="wrap_content">

                <LinearLayout
                    baram:layout_width="wrap_content"
                    baram:layout_height="wrap_content"
                    baram:orientation="horizontal">

                    <Button
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:text="Item 1"/>

                    <Button
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:text="Item 2"/>

                    <Button
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:text="Item 3"/>

                    <Button
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:text="Item 4"/>

                    <Button
                        baram:layout_width="wrap_content"
                        baram:layout_height="wrap_content"
                        baram:text="Item 5"/>

                </LinearLayout>

            </HorizontalScrollView>

            <TextView
                style="@style/ComponentLabel"
                baram:text="ViewFlipper • API 1"/>

            <ViewFlipper
                baram:id="@+id/viewFlipper"
                baram:layout_width="match_parent"
                baram:layout_height="100dp"
                baram:autoStart="true"
                baram:flipInterval="2000">

                <TextView
                    baram:layout_width="match_parent"
                    baram:layout_height="match_parent"
                    baram:gravity="center"
                    baram:text="View 1"
                    baram:textSize="24sp"/>

                <TextView
                    baram:layout_width="match_parent"
                    baram:layout_height="match_parent"
                    baram:gravity="center"
                    baram:text="View 2"
                    baram:textSize="24sp"/>

            </ViewFlipper>

            <Space
                baram:layout_width="match_parent"
                baram:layout_height="40dp"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>