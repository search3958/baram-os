[fun = refreshValues]
setText fps-value = now://fps
setText window-value = now://window
setText key-value = now://key
setText mouse-value = now://mouse
setText h-value = now://h
setText m-value = now://m
setText s-value = now://s
setText hh-value = now://hh
setText mm-value = now://mm
setText ss-value = now://ss
setText hhmm-value = now://hhmm
setText hhmmss-value = now://hhmmss

[onClick = refresh-values]
fun = refreshValues
