config {
    title("タスクマネージャー")
    script("stats.w3s")
}

button.refresh-values {
    text("内容更新")
    type("primary")
}

text {
    text("FPS")
}
card{
    text.fps-value { text("-") }
}

text {
    text("システムの時刻")
}
card{
    text.hhmmss-value { text("-") }
}

list-box {
    text("OS状況")
    list {
        text("ウィンドウ数")
        detail.window-value { text("-") }
    }
    list {
        text("キーイベント数")
        detail.key-value { text("-") }
    }
    list {
        text("マウスイベント数")
        detail.mouse-value { text("-") }
    }
}
