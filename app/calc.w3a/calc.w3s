[fun = refreshExpression]
setText expression-display = expression

[onClick = digit-0]
expression = append "0"
fun = refreshExpression
[onClick = digit-1]
expression = append "1"
fun = refreshExpression
[onClick = digit-2]
expression = append "2"
fun = refreshExpression
[onClick = digit-3]
expression = append "3"
fun = refreshExpression
[onClick = digit-4]
expression = append "4"
fun = refreshExpression
[onClick = digit-5]
expression = append "5"
fun = refreshExpression
[onClick = digit-6]
expression = append "6"
fun = refreshExpression
[onClick = digit-7]
expression = append "7"
fun = refreshExpression
[onClick = digit-8]
expression = append "8"
fun = refreshExpression
[onClick = digit-9]
expression = append "9"
fun = refreshExpression
[onClick = op-div]
expression = append "/"
fun = refreshExpression
[onClick = op-mul]
expression = append "*"
fun = refreshExpression
[onClick = op-sub]
expression = append "-"
fun = refreshExpression
[onClick = op-add]
expression = append "+"
fun = refreshExpression

[onClick = equals]
result = calculate expression
setText result-display = result

[onClick = clear]
expression = ""
result = "0"
setText expression-display = expression
setText result-display = result
