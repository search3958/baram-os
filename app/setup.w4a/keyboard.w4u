<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:padding="28dip" baram:layout_gap="10dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="キーボード設定" baram:textSize="26sp" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Shift にしたいキーを押してください" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="待機中..." /><LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" /><Button baram:id="@+id/skip" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="スキップ" /></LinearLayout>
