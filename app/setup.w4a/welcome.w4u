<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:background="#FAFAFC"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="64dip" baram:orientation="horizontal" baram:gravity="center_vertical" baram:paddingLeft="20dip" baram:paddingRight="20dip" baram:background="#006AFF"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Baram OS" baram:textSize="24sp" baram:textColor="#FFFFFF"/></LinearLayout><LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="vertical" baram:padding="24dip" baram:layout_gap="8dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Baram OSへようこそ" baram:textSize="26sp"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="このデバイスを使い始めるために、いくつかの設定を行います。"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Enterキー または 続行ボタンをクリックして始めます" baram:textColor="#666666"/></LinearLayout><LinearLayout baram:layout_width="fill_parent" baram:layout_height="64dip" baram:orientation="horizontal" baram:gravity="center_vertical" baram:paddingLeft="16dip" baram:paddingRight="16dip" baram:layout_gap="8dip"><Button baram:id="@+id/skip" baram:layout_width="0dip" baram:layout_height="48dip" baram:layout_weight="1" baram:text="後で設定"/><PrimaryButton baram:id="@+id/continue" baram:layout_width="0dip" baram:layout_height="48dip" baram:layout_weight="1" baram:text="続行"/></LinearLayout></LinearLayout>
