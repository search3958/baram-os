<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:padding="28dip" baram:layout_gap="10dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="歓迎します" baram:textSize="26sp" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Baram OSへようこそ。簡単なセットアップを開始しましょう。" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Enterキー または 続行ボタンをクリックして始めます" /><LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" /><LinearLayout baram:layout_width="fill_parent" baram:layout_height="48dip" baram:orientation="horizontal" baram:layout_gap="8dip"><Button baram:id="@+id/skip" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="スキップ" /><PrimaryButton baram:id="@+id/continue" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="続行" /></LinearLayout></LinearLayout>
