config { title("Software Keyboard") script("keyboard.w3s") }

head { text("Software Keyboard") }
button.close { text("Close") type("tonal") }

flex {
    button.key-q { text("Q") }
    button.key-w { text("W") }
    button.key-e { text("E") }
    button.key-r { text("R") }
    button.key-t { text("T") }
    button.key-y { text("Y") }
    button.key-u { text("U") }
    button.key-i { text("I") }
    button.key-o { text("O") }
    button.key-p { text("P") }
}
flex {
    button.key-a { text("A") }
    button.key-s { text("S") }
    button.key-d { text("D") }
    button.key-f { text("F") }
    button.key-g { text("G") }
    button.key-h { text("H") }
    button.key-j { text("J") }
    button.key-k { text("K") }
    button.key-l { text("L") }
}
flex {
    button.key-z { text("Z") }
    button.key-x { text("X") }
    button.key-c { text("C") }
    button.key-v { text("V") }
    button.key-b { text("B") }
    button.key-n { text("N") }
    button.key-m { text("M") }
}
