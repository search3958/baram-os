screen{
    id: (welcome),

    card{
        id: (setupCard),
        height: (320),
        text: ("Hello"),

        text{
            text: ("Baram OSへようこそ。")
        },
        text{
            text: ("Enterキーで開始します。")
        },
        spacer{
            height: (96)
        },
        hStack{
            tonalButton{
                text: ("スキップ"),
                oneClick: (runCommand = "setup://skip")
            },
            button{
                text: ("続行"),
                oneClick: (runCommand = "setup://continue")
            }
        }
    }
}

screen{
    id: (keyboard),

    card{
        id: (setupCard),
        height: (320),
        text: ("キーボード設定"),

        text{
            text: ("Shift にしたいキーを押してください")
        },
        text{
            text: ("待機中...")
        },
        spacer{
            height: (96)
        },
        tonalButton{
            text: ("スキップ"),
            oneClick: (runCommand = "setup://skip")
        }
    }
}

screen{
    id: (keyboardDetected),

    card{
        id: (setupCard),
        height: (320),
        text: ("完了"),

        text{
            text: ("Enterキーまたは完了ボタンでセットアップを終了します")
        },
        spacer{
            height: (124)
        },
        button{
            text: ("完了"),
            oneClick: (runCommand = "setup://finish")
        }
    }
}
