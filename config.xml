<baram-os-config>
    <display>
        <pointer>
            <size>10</size>
        </pointer>
        <wallpaper>
            <file>baram.png</file>
            <color></color>
            <mode>file</mode>
        </wallpaper>
        <hud>
            <enabled>1</enabled>
        </hud>
    </display>
    <ui-theme>
        <color>
            <bg>F0F0F0</bg>
            <panel>FFFFFF</panel>
            <text>1A1A1A</text>
            <muted>666666</muted>
            <border>D0D0D0</border>
            <taskbar>FFFFFF</taskbar>
            <win_bg>FFFFFF</win_bg>
            <win_inactive>E8E8E8</win_inactive>
            <card_bg>F5F5F5</card_bg>
            <shadow>A0A0A0</shadow>
            <btn_bg>D8D8D8</btn_bg>
            <btn_primary>0A60FF</btn_primary>
            <btn_primary_hover>0850DD</btn_primary_hover>
            <btn_tonal>E6E6E6</btn_tonal>
            <btn_tonal_hover>D2D2D2</btn_tonal_hover>
            <btn_text>FFFFFF</btn_text>
            <switch_on>0A60FF</switch_on>
            <switch_off>DDDDDD</switch_off>
        </color>
        <window>
            <title_bar_h>30</title_bar_h>
            <min_win_w>120</min_win_w>
            <min_win_h>60</min_win_h>
            <win_radius>16</win_radius>
            <shadow_pad>30</shadow_pad>
            <shadow_blur>30</shadow_blur>
            <scroll_speed>15</scroll_speed>
        </window>
        <button>
            <size>20</size>
            <radius>8</radius>
            <h>40</h>
            <min_w>50</min_w>
            <gap>16</gap>
            <corner>20</corner>
        </button>
        <card>
            <w>480</w>
            <h>320</h>
            <radius>20</radius>
            <padding>4</padding>
            <title_h>36</title_h>
            <child_gap>4</child_gap>
        </card>
        <taskbar>
            <h>48</h>
            <blur>30</blur>
            <icon_size>24</icon_size>
            <icon_x>16</icon_x>
        </taskbar>
        <launcher>
            <cols>5</cols>
            <icon_size>64</icon_size>
            <icon_gap>24</icon_gap>
            <label_h>20</label_h>
            <blur>60</blur>
            <darken>200</darken>
        </launcher>
        <cursor>
            <w>15</w>
            <h>19</h>
            <size_w>19</size_w>
            <size_h>19</size_h>
            <shadow_blur>12</shadow_blur>
            <shadow_x>3</shadow_x>
            <shadow_y>4</shadow_y>
        </cursor>
        <font>
            <size>14.0</size>
            <size_hud>16.0</size_hud>
            <cache_cap>128</cache_cap>
            <hud_cache_cap>64</hud_cache_cap>
        </font>
        <spacing>
            <margin>10</margin>
            <line_h>16</line_h>
            <stack_gap>8</stack_gap>
        </spacing>
        <blur>
            <radius>60</radius>
        </blur>
        <switch>
            <w>22</w>
            <h>22</h>
            <radius>8</radius>
        </switch>
        <input>
            <h>48</h>
        </input>
    </ui-theme>

    <keyboard>
        <shift_key>0</shift_key>
    </keyboard>
    <mouse>
        <speed>1.0</speed>
        <base_gain>0.12</base_gain>
        <quadratic_gain>0.004</quadratic_gain>
        <max_gain>4.0</max_gain>
        <click_guard_distance>3.0</click_guard_distance>
        <click_guard_reports>3</click_guard_reports>
        <smoothing>0.10</smoothing>
    </mouse>
    <trackpad>
        <speed>6.0</speed>
        <base_gain>0.1</base_gain>
        <quadratic_gain>0.006</quadratic_gain>
        <max_gain>7.0</max_gain>
        <click_guard_distance>8.0</click_guard_distance>
        <click_guard_reports>3</click_guard_reports>
        <smoothing>0.10</smoothing>
    </trackpad>
    <system>
        <done>0</done>
        <reset>
            <option/>
        </reset>
    </system>
</baram-os-config>
