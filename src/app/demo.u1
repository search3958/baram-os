color:"#3765ff";
head:"UI Script Demo";
text:"これはBaramOSのUI Scriptです。";
br:line;
h3:"ボタン例";
button:text"Filled":type"filled";
button:text"Outline":type"outline";
button:text"Text":type"text";
br:line;
h3:"カード例";
card:title"Hello":text"UI Scriptカード":button"OK";
card:title"BaramOS":text"カスタムOS":button"Open";
br:line;
h3:"リスト例";
list:title"設定":text"設定項目です":button"開く";
list:title"ファイル":text"ファイル一覧":button"表示";
br:line;
h3:"テキスト装飾";
text:"#0078d7{カスタム色}のテキスト";
text:"**太字**と通常テキスト";
text:"緑#006000{緑色}と赤#ff0000{赤色}の虹";
br:line;
h3:"更多サンプル";
text:"スクロールできるようになりました。";
text:"ウィンドウの内容が長い場合でも、";
text:"スクロールして確認できます。";
br:line;
button:text"Button A":type"filled";
button:text"Button B":type"outline";
button:text"Button C":type"text";
br:line;
card:title"Card 2":text"もう一つのカード":button"Action";
br:line;
text:"行1: サンプルテキスト";
text:"行2: もう一行";
text:"行3: さらに追加";
text:"行4: 最後の行";
