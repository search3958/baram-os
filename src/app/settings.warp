screen{
    id: (main),

    Header{
        text: ("Settings"),
    },

    card{
        text: ("Wallpaper"),

        text{
            text: ("Select a wallpaper theme")
        },

        hStack{
            button{
                text: ("Baram"),
                oneClick: (runCommand = "os://display/wallpaper?file=light.png")
            },

            button{
                text: ("Hanul"),
                oneClick: (runCommand = "os://display/wallpaper?file=hanul.png")
            },

            button{
                text: ("Reflect"),
                oneClick: (runCommand = "os://display/wallpaper?file=reflect.png")
            },
        },

        button{
            text: ("Solid Red"),
            oneClick: (runCommand = "os://display/wallpaper?color=#990000")
        },
    },

    card{
        text: ("Pointer"),

        text{
            text: ("Pointer size: " + --pointerSize)
        },

        hStack{
            button{
                text: ("Small"),
                oneClick: (--pointerSize = "1", runCommand = "os://display/pointer?size=1")
            },

            button{
                text: ("Medium"),
                oneClick: (--pointerSize = "1.5", runCommand = "os://display/pointer?size=2")
            },

            button{
                text: ("Large"),
                oneClick: (--pointerSize = "2", runCommand = "os://display/pointer?size=3")
            },
        },
    },

    card{
        text: ("HUD"),

        text{
            text: ("Status bar display")
        },

        switch{
            --hudEnabled: ("true"),
            output: (--hudEnabled)
        },
    },
}
