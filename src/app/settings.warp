screen{
    id: (main),

    Header{
        text: ("Settings"),
    },

    card{
        text: ("Wallpaper"),

        text{
            text: ("Select a wallpaper theme")
        },

        hStack{
            button{
                text: ("Baram"),
                oneClick: (runCommand = "os://display/wallpaper?file=baram")
            },

            button{
                text: ("Hanul"),
                oneClick: (runCommand = "os://display/wallpaper?file=hanul")
            },

            button{
                text: ("Reflect"),
                oneClick: (runCommand = "os://display/wallpaper?file=reflect")
            },
        },

        button{
            text: ("Solid Red"),
            oneClick: (runCommand = "os://display/wallpaper?color=#990000")
        },
    },

    card{
        text: ("Pointer"),

        text{
            text: ("Pointer size: " + --pointerSize)
        },

        hStack{
            button{
                text: ("Small"),
                oneClick: (--pointerSize = "10", runCommand = "os://display/pointer?size=10")
            },

            button{
                text: ("Medium"),
                oneClick: (--pointerSize = "15", runCommand = "os://display/pointer?size=15")
            },

            button{
                text: ("Large"),
                oneClick: (--pointerSize = "20", runCommand = "os://display/pointer?size=20")
            },
        },
    },

    card{
        text: ("HUD"),

        text{
            text: ("Status bar display")
        },

        switch{
            --hudEnabled: ("true"),
            output: (--hudEnabled)
        },
    },
}
