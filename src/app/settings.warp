screen{
    id: (main),

    Header{
        text: ("Settings"),
    },

    card{
        text: ("Wallpaper"),

        text{
            text: ("Select a wallpaper theme")
        },

        hStack{
            button{
                text: ("baram"),
                oneClick: (--wallpaper = "baram", --wallpaperChanged = "true")
            },

            button{
                text: ("Hanul"),
                oneClick: (--wallpaper = "hanul", --wallpaperChanged = "true")
            },

            button{
                text: ("Reflect"),
                oneClick: (--wallpaper = "reflect", --wallpaperChanged = "true")
            },
        },

        button{
            text: ("Solid Red"),
            oneClick: (--wallpaper = "color:#990000", --wallpaperChanged = "true")
        },
    },

    card{
        text: ("Pointer"),

        text{
            text: ("Pointer size: " + --pointerSize)
        },

        hStack{
            button{
                text: ("Small"),
                oneClick: (--pointerSize = "1", --pointerChanged = "true")
            },

            button{
                text: ("Medium"),
                oneClick: (--pointerSize = "2", --pointerChanged = "true")
            },

            button{
                text: ("Large"),
                oneClick: (--pointerSize = "3", --pointerChanged = "true")
            },
        },
    },

    card{
        text: ("HUD"),

        text{
            text: ("Status bar display")
        },

        switch{
            --hudEnabled: ("true"),
            output: (--hudEnabled)
        },
    },
}
