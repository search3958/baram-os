screen{
    id: (main),
    vStack{
        text{
            text: ("Demo: OS Base Integration"),
            size: (18)
        },
        card{
            id: (calcBar),
            text: ("Calculation Demo")
        },
        button{
            text: ("Toggle Dark"),
            oneClick: (run{os_toggle_dark})
        },
        button{
            text: ("Wait Test"),
            oneClick: (run{os_wait_test})
        },
        card{
            id: (editorSurface),
            text: ("Editor Area")
        },
        button{
            text: ("Back"),
            oneClick: (run{os_back})
        }
    }
}
