baram-os-config{
    c:("files.c")
}

screen {
    id: (files_main),
    backgroundColor: (#1a1a1a),
    
    // ヘッダー部分
    hStack {
        padding: (20),
        text {
            text: ("File Manager"),
            size: (20),
            color: (#ffffff)
        }
    },
    
    // ファイルリスト表示エリア
    vStack {
        id: (file_list),
        padding: (15),
        spacing: (10)
    }
}
