baram-os-config{
    lua:("files.lua")
}

screen {
    id: (files_main),
    backgroundColor: (#1a1a1a),

    hStack {
        padding: (20),
        text {
            text: ("File Manager"),
            size: (20),
            color: (#ffffff)
        },
        spacer { width: (max) },
        text {
            --status: ("Ready"),
            text: (--status),
            color: (#00ff00),
            size: (14)
        }
    },

    // ファイルリスト - Lua で動的に追加
    vStack {
        id: (file_list),
        padding: (15),
        spacing: (10),
        fill: (true)
    }
}
