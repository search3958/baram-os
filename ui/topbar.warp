baram-os-config{
    height:("75"),
    width:("100vw"),
    left:("0"),
    top:("0"),
    showBar:(false),
    resize:(false),
    move:(false),
    front:(true)
},

screen{
    id: (main),

    hStack{
        button{
            text: ("태양바람0S"),
            oneClick: (setScreen{baram})
        },
        tonalButton{
            text: ("再起動"),
            radius: (100%),
            oneClick: (setScreen{reboot})
        },
        tonalButton{
            text: ("コマンド"),
            oneClick: (setScreen{terminal})
        },
        tonalButton{
            text: ("外観モード"),
            radius: (12),
            oneClick: (setScreen{mode})
        }
    }
}


screen{
    id: (baram),

    hStack{

        tonalButton{
            text: ("<"),
            oneClick: (setScreen{main})
        },

        button{
            text: ("設定"),
            oneClick: (run{"warp setting.warp"})
        },
        button{
            text: ("ターミナル"),
            oneClick: (run{"warp terminal.warp"})
        },
        button{
            text: ("ファイルマネージャー"),
            oneClick: (run{"warp files.warp"})
        },
        button{
            text: ("Warp Demo"),
            oneClick: (run{"warp new.warp"})
        },
        button{
            text: ("テキストエディタ"),
            oneClick: (run{"warp textedit.warp"})
        },
    }
},

screen{
    id: (reboot),

    hStack{

        tonalButton{
            text: ("<"),
            oneClick: (setScreen{main})
        },
        text{
            text:("再起動します。正気ですね？")
        }

        tonalButton{
            text: ("キャンセル"),
            oneClick: (setScreen{main})
        },

        tonalButton{
            text: ("再起動"),
            oneClick: (reset{now})
        }
    }
},


screen{
    id: (terminal),

    hStack{
        tonalButton{
            text: ("<"),
            oneClick: (setScreen{main})
        },
        input{
            --terminalInput: (""),
            output: (--terminalInput),
            placeholder: ("コマンドを入力...")
        },

        button{
            text: ("実行"),
            oneClick: (run{--terminalInput})
        }
    }
},


screen{
    id: (mode),

    hStack{

        tonalButton{
            text: ("<"),
            oneClick: (setScreen{main})
        },
        text{
            text:("外観モード")
        }

        tonalButton{
            text: ("ライト"),
            oneClick: (~~main/dark = false)
        },

        tonalButton{
            text: ("ダーク"),
            oneClick: (~~main/dark = true)
        }
    }
},
