screen{
    id: (main),

    Header{
        text: ("設定")
    },

    card{
        text: ("外観"),

        text{
            text: ("現在: " + ~~main/dark)
        },

        hStack{
            button{
                text: ("ライト"),
                oneClick: (~~main/dark = false)
            },

            tonalButton{
                text: ("ダーク"),
                oneClick: (~~main/dark = true)
            }
        }
    },

    card{
        text: ("HUD"),

        text{
            text: ("showHUD: " + ~~dev/showHUD)
        },

        hStack{
            button{
                text: ("HUD ON"),
                oneClick: (~~dev/showHUD = true)
            },

            tonalButton{
                text: ("HUD OFF"),
                oneClick: (~~dev/showHUD = false)
            }
        }
    },

    card{
        text: ("開発イベント"),

        text{
            text: ("pointerCheck: " + ~~dev/pointerCheck)
        },

        hStack{
            button{
                text: ("Pointer ON"),
                oneClick: (~~dev/pointerCheck = true)
            },

            tonalButton{
                text: ("Pointer OFF"),
                oneClick: (~~dev/pointerCheck = false)
            }
        },

        text{
            text: ("eventCheck: " + ~~dev/eventCheck)
        },

        hStack{
            button{
                text: ("Event ON"),
                oneClick: (~~dev/eventCheck = true)
            },

            tonalButton{
                text: ("Event OFF"),
                oneClick: (~~dev/eventCheck = false)
            }
        }
    },

    card{
        text: ("その他"),

        hStack{
            tonalButton{
                text: ("コマンド"),
                oneClick: (setScreen{terminal})
            },

            tonalButton{
                text: ("再起動"),
                oneClick: (setScreen{reboot})
            }
        }
    }
}

screen{
    id: (terminal),

    Header{
        text: ("設定 / コマンド")
    },

    tonalButton{
        text: ("戻る"),
        oneClick: (setScreen{main})
    },

    card{
        text: ("開発コマンド"),

        text{
            text: ("例: dev showHUD=true / dev pointerCheck=true / dev eventCheck=true")
        },

        input{
            --terminalInput: (""),
            output: (--terminalInput),
            placeholder: ("コマンドを入力...")
        },

        button{
            text: ("実行"),
            oneClick: (run{--terminalInput})
        }
    }
},

screen{
    id: (reboot),

    Header{
        text: ("設定 / 再起動")
    },

    tonalButton{
        text: ("戻る"),
        oneClick: (setScreen{main})
    },

    card{
        text: ("システム"),

        text{
            text: ("再起動します。正気ですね？")
        },

        hStack{
            tonalButton{
                text: ("キャンセル"),
                oneClick: (setScreen{main})
            },

            button{
                text: ("再起動"),
                oneClick: (reset{now})
            }
        }
    }
},
