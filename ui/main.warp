screen(
    id:main

    Header(
    text:"Warp Demo"

    )


    text(
    text:"これは新しい、ネイティブとWeb技術が融合する言語です。気になる反応は"+--mainText
    --mainText:"..."
    )

    card(
    text:"内容変更"
    text(
        text:"クリックにより表示内容が変更されます"
    )
        button(
            text:"GOOD"
            oneClick:--mainText="良いみたいです!"
        )
        button(
            text:"BAD"
            oneClick:--mainText="あまり良くないようですね。"
        )
    )

    card(
        text:"button"
        text(
            text:"通常ボタン"
        )
        card(
            text:"使用例"
            color:black
            text(
                text:"button\(
                \n\ \ text\:\"戻る\"
                \n\)"
            )
        )
    )
)
