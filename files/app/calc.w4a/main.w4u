<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:fillViewport="false">
<LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:padding="16dip">
  <TextView baram:id="@+id/expression" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:layout_marginTop="16dip" baram:text="" baram:gravity="right|center_vertical" />
  <TextView baram:id="@+id/result" baram:layout_width="fill_parent" baram:layout_height="64dip" baram:text="0" baram:textSize="32sp" baram:gravity="right|center_vertical" />
  <LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="vertical">
    <LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="horizontal"><Button baram:id="@+id/d7" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="7" /><Button baram:id="@+id/d8" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="8" /><Button baram:id="@+id/d9" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="9" /><Button baram:id="@+id/div" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="÷" /></LinearLayout>
    <LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="horizontal"><Button baram:id="@+id/d4" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="4" /><Button baram:id="@+id/d5" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="5" /><Button baram:id="@+id/d6" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="6" /><Button baram:id="@+id/mul" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="×" /></LinearLayout>
    <LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="horizontal"><Button baram:id="@+id/d1" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="1" /><Button baram:id="@+id/d2" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="2" /><Button baram:id="@+id/d3" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="3" /><Button baram:id="@+id/sub" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="−" /></LinearLayout>
    <LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="horizontal"><Button baram:id="@+id/d0" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="0" /><Button baram:id="@+id/eq" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="=" /><Button baram:id="@+id/add" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="+" /><PrimaryButton baram:id="@+id/clear" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="C" /></LinearLayout>
  </LinearLayout>
</LinearLayout>
</ScrollView>
