<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical"><ScrollView baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:orientation="vertical" baram:padding="16dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="カスタマイズ" baram:textSize="24sp" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:layout_marginTop="20dip" baram:text="壁紙" /><Button baram:id="@+id/wall_baram" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Baram" /><Button baram:id="@+id/wall_hanul" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Hanul" /><Button baram:id="@+id/wall_reflect" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Reflect" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:layout_marginTop="16dip" baram:text="塗りつぶし色" /><Button baram:id="@+id/color_white" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="白" /><Button baram:id="@+id/color_black" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="黒" /><Button baram:id="@+id/color_gray" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="グレー" /><Button baram:id="@+id/color_blue" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="青" /><Button baram:id="@+id/color_green" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="緑" /><Button baram:id="@+id/color_red" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="赤" /></LinearLayout></ScrollView><Button baram:id="@+id/back" baram:fixed="true" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="戻る" /></LinearLayout>
