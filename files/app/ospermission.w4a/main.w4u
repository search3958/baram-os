<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:padding="16dip" baram:layout_gap="8dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="操作体系設定の変更を許可しますか？" baram:textSize="22sp"/><LinearLayout baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:orientation="vertical" baram:padding="12dip" baram:layout_gap="4dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="アプリ名"/><TextView baram:id="@+id/app-name" baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="アプリ: 不明"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="要求された操作"/><TextView baram:id="@+id/request-path" baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="不明"/></LinearLayout><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="常に許可の場合，アプリはOSのリセットまで担当できるようになります。"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="許可はこのアプリバージョンにのみ与えられます。"/><LinearLayout baram:layout_width="fill_parent" baram:layout_height="48dip" baram:orientation="horizontal" baram:layout_gap="8dip"><Button baram:id="@+id/permission-deny" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="許可しない"/><Button baram:id="@+id/permission-once" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="一度だけ許可"/><PrimaryButton baram:id="@+id/permission-always" baram:layout_width="0dip" baram:layout_height="fill_parent" baram:layout_weight="1" baram:text="常に許可"/></LinearLayout></LinearLayout>
