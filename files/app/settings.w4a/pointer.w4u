<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:fillViewport="false">
<LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical"><ScrollView baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:orientation="vertical" baram:padding="16dip">
  <TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="マウスポインター設定" baram:textSize="24sp" /><TextView baram:id="@+id/current" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:layout_marginTop="16dip" baram:text="現在: -" />
  <PrimaryButton baram:id="@+id/small" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Small" /><Button baram:id="@+id/medium" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Medium" /><Button baram:id="@+id/large" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Large" />
  <TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:layout_marginTop="24dip" baram:text="トラックパッドの速度" /><Button baram:id="@+id/trackpad1" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="1倍" /><Button baram:id="@+id/trackpad3" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="3倍" /><Button baram:id="@+id/trackpad5" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="5倍（推奨）" /><Button baram:id="@+id/trackpad6" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="6倍" /><Button baram:id="@+id/trackpad8" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="8倍" />
  <TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:layout_marginTop="24dip" baram:text="USBマウスの速度" /><Button baram:id="@+id/mouse05" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="0.5倍" /><Button baram:id="@+id/mouse1" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="1倍（標準）" /><Button baram:id="@+id/mouse2" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="2倍" /><Button baram:id="@+id/mouse4" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="4倍" />
</LinearLayout></ScrollView><Button baram:id="@+id/back" baram:fixed="true" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="戻る" /></LinearLayout>
</ScrollView>
