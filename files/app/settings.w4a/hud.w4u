<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:fillViewport="false">
<LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:padding="16dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="HUD設定" baram:textSize="24sp" /><Switch baram:id="@+id/toggle" baram:layout_width="fill_parent" baram:layout_height="60dip" baram:text="ステータスバーに表示" baram:checked="true" /><Button baram:id="@+id/back" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="戻る" /></LinearLayout>
</ScrollView>
