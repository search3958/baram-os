<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical"><ScrollView baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:orientation="vertical" baram:padding="16dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="テーマ設定" baram:textSize="24sp" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:layout_marginTop="20dip" baram:text="壁紙" /><Button baram:id="@+id/wall_baram" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Baram" /><Button baram:id="@+id/wall_hanul" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Hanul" /><Button baram:id="@+id/wall_reflect" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="Reflect" /></LinearLayout></ScrollView><Button baram:id="@+id/back" baram:fixed="true" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="戻る" /></LinearLayout>
