<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical"><ScrollView baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:orientation="vertical" baram:padding="16dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="システム設定" baram:textSize="24sp" /><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:layout_marginTop="16dip" baram:text="タイムゾーン" /><PrimaryButton baram:id="@+id/tz_japan" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+09:00 日本，京城，平壌" /><Button baram:id="@+id/tz_utc" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+00:00 ロンドン，リスボン" /><Button baram:id="@+id/tz_minus12" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="-12:00 ベーカー島" /><Button baram:id="@+id/tz_minus8" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="-08:00 ロサンゼルス，バンクーバー" /><Button baram:id="@+id/tz_minus5" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="-05:00 ニューヨーク，トロント" /><Button baram:id="@+id/tz_plus1" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+01:00 パリ，ベルリン，ローマ" /><Button baram:id="@+id/tz_plus3" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+03:00 モスクワ，イスタンブール" /><Button baram:id="@+id/tz_plus5" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+05:00 カラチ，タシュケント" /><Button baram:id="@+id/tz_plus8" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+08:00 北京，香港，台北，シンガポール" /><Button baram:id="@+id/tz_plus10" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+10:00 シドニー，グアム" /><Button baram:id="@+id/tz_plus12" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="+12:00 フィジー，マジュロ" /><Button baram:id="@+id/reset" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:layout_marginTop="20dip" baram:text="再起動してリセット" /></LinearLayout></ScrollView><Button baram:id="@+id/back" baram:fixed="true" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="戻る" /></LinearLayout>
