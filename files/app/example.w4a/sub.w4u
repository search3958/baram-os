<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:baram="http://schemas.baram.com/apk/res/baram"
    baram:id="@+id/scroll_sub"
    baram:layout_width="match_parent"
    baram:layout_height="match_parent"
    baram:fillViewport="true">

    <LinearLayout
        baram:id="@+id/sub_root"
        baram:layout_width="match_parent"
        baram:layout_height="wrap_content"
        baram:orientation="vertical"
        baram:padding="16dp">

        <!-- タイトルエリア -->
        <TextView
            style="@style/SectionTitle"
            baram:id="@+id/sub_title"
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="Sub Screen / Settings"
            baram:textSize="20sp"
            baram:textStyle="bold"
            baram:textColor="#000000"/>

        <TextView
            style="@style/SectionDescription"
            baram:id="@+id/sub_desc"
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="Control visibility &amp; Status"
            baram:textSize="14sp"
            baram:textColor="#666666"
            baram:layout_marginBottom="16dp"/>

        <!-- 設定・トグルセクション -->
        <TextView
            style="@style/ComponentLabel"
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="Panel Settings"
            baram:textSize="14sp"
            baram:textStyle="bold"
            baram:textColor="#333333"
            baram:layout_marginBottom="8dp"/>

        <Switch
            baram:id="@+id/switch_toggle"
            baram:layout_width="wrap_content"
            baram:layout_height="wrap_content"
            baram:text="Enable Feature Panel"
            baram:checked="true"
            baram:layout_marginBottom="12dp"/>

        <Button
            baram:id="@+id/btn_toggle_panel"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:text="Hide Panel"
            baram:layout_marginBottom="16dp"/>

        <!-- 切り替え用パネル -->
        <LinearLayout
            baram:id="@+id/panel_content"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:orientation="vertical"
            baram:layout_marginBottom="24dp">

            <TextView
                baram:layout_width="wrap_content"
                baram:layout_height="wrap_content"
                baram:text="Panel Content Active"
                baram:textSize="14sp"
                baram:textStyle="bold"
                baram:textColor="#000000"/>

            <ProgressBar
                style="?baram:attr/progressBarStyleHorizontal"
                baram:layout_width="match_parent"
                baram:layout_height="wrap_content"
                baram:max="100"
                baram:progress="75"
                baram:layout_marginTop="8dp"/>
        </LinearLayout>

        <Space
            baram:layout_width="match_parent"
            baram:layout_height="0dp"
            baram:layout_weight="1"/>

        <!-- 戻るボタン -->
        <PrimaryButton
            baram:id="@+id/btn_back_main"
            baram:layout_width="match_parent"
            baram:layout_height="wrap_content"
            baram:text="<- Back to Main Screen"/>

    </LinearLayout>
</ScrollView>