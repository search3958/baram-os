<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:fillViewport="false">
<LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:background="#FAFAFC"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="56dip" baram:orientation="horizontal" baram:gravity="center_vertical" baram:paddingLeft="20dip" baram:paddingRight="20dip" baram:paddingTop="20dip" baram:background="#FFFFFF"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="タイムゾーン" baram:textSize="22sp" baram:textColor="#000000"/></LinearLayout><ScrollView baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:fillViewport="true"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:orientation="vertical" baram:padding="16dip" baram:layout_gap="6dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="お住まいの地域に近い時刻を選んでください"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="時刻はUTCとの差で表示されます" baram:textColor="#666666"/><Button baram:id="@+id/timezone_minus12" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="-12:00　ベーカー島"/><Button baram:id="@+id/timezone_minus8" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="-08:00　ロサンゼルス，バンクーバー"/><Button baram:id="@+id/timezone_minus5" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="-05:00　ニューヨーク，トロント"/><Button baram:id="@+id/timezone_minus3" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="-03:00　サンパウロ，ブエノスアイレス"/><Button baram:id="@+id/timezone_plus0" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+00:00　ロンドン，リスボン"/><Button baram:id="@+id/timezone_plus1" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+01:00　パリ，ベルリン，ローマ"/><Button baram:id="@+id/timezone_plus3" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+03:00　モスクワ，イスタンブール"/><Button baram:id="@+id/timezone_plus5" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+05:00　カラチ，タシュケント"/><Button baram:id="@+id/timezone_plus8" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+08:00　北京，香港，台北，シンガポール"/><PrimaryButton baram:id="@+id/timezone_plus9" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+09:00　東京，京城，平壌"/><Button baram:id="@+id/timezone_plus12" baram:layout_width="fill_parent" baram:layout_height="40dip" baram:text="+12:00　フィジー，マジュロ"/></LinearLayout></ScrollView></LinearLayout>
</ScrollView>
