<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:baram="http://schemas.baram.com/apk/res/baram" baram:layout_width="fill_parent" baram:layout_height="fill_parent" baram:orientation="vertical" baram:background="#FAFAFC"><LinearLayout baram:layout_width="fill_parent" baram:layout_height="64dip" baram:orientation="horizontal" baram:gravity="center_vertical" baram:paddingLeft="20dip" baram:paddingRight="20dip" baram:background="#FFFFFF"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="キーボード設定" baram:textSize="22sp" baram:textColor="#000000"/></LinearLayout><LinearLayout baram:layout_width="fill_parent" baram:layout_height="0dip" baram:layout_weight="1" baram:orientation="vertical" baram:padding="24dip" baram:layout_gap="8dip"><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="キーボードを設定" baram:textSize="26sp"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="Shift にしたいキーを押してください。あとで設定することもできます。"/><TextView baram:layout_width="fill_parent" baram:layout_height="wrap_content" baram:text="待機中..." baram:textColor="#666666"/></LinearLayout><LinearLayout baram:layout_width="fill_parent" baram:layout_height="64dip" baram:orientation="horizontal" baram:gravity="center_vertical" baram:paddingLeft="16dip" baram:paddingRight="16dip"><Button baram:id="@+id/skip" baram:layout_width="fill_parent" baram:layout_height="48dip" baram:text="後で設定"/></LinearLayout></LinearLayout>
